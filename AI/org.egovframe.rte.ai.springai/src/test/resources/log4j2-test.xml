<?xml version="1.0" encoding="UTF-8"?>
<!-- 테스트용 로깅 : AI 감사 채널(EGOV_AI_AUDIT) INFO 선언 필수 (미선언 시 root(warn)에 걸러짐, 운영도 동일 — 모듈 가이드 참조) -->
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="EGOV_AI_AUDIT" level="info" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="org.egovframe.rte.ai" level="info"/>
        <Root level="warn">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
